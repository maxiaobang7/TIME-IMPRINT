/* Same structure as the editor: the canvas stays put, only the controls scroll. */
.collage {
  display: flex;
  flex-direction: column;
  height: 100vh;
  overflow: hidden;
}

.stage {
  flex: none;
  padding: 16rpx 32rpx 12rpx;
  background: var(--bg);
  border-bottom: 2rpx solid var(--line);
}

.canvas-wrap {
  display: flex;
  justify-content: center;
}

.preview {
  display: block;
  border-radius: 12rpx;
  box-shadow: 0 12rpx 32rpx rgba(42, 36, 32, 0.16);
}

.notice {
  margin-top: 12rpx;
  padding: 10rpx 20rpx;
  border-radius: 12rpx;
  background: #fcefd9;
  color: #8a5a12;
  font-size: 22rpx;
  text-align: center;
}

.stage-hidden {
  height: 0;
  padding: 0;
  overflow: hidden;
  border: none;
}

.controls {
  flex: 1;
  min-height: 0;
}

.controls-end {
  height: 32rpx;
}

.panel {
  margin: 20rpx 24rpx 0;
  padding: 8rpx 24rpx;
  border-radius: 28rpx;
  background: var(--card);
}

.field {
  padding: 24rpx 0;
  border-bottom: 2rpx solid var(--line);
}

.field:last-child {
  border-bottom: none;
}

.label-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 48rpx;
  margin-bottom: 12rpx;
}

.label {
  font-size: 26rpx;
  font-weight: 700;
}

.field > .label {
  display: block;
  margin-bottom: 16rpx;
}

.value {
  color: var(--muted);
  font-size: 24rpx;
}

.input {
  height: 84rpx;
  margin-top: 12rpx;
  padding: 0 24rpx;
  border-radius: 16rpx;
  background: #f5f0e8;
  font-size: 28rpx;
}

.hint {
  margin-top: 12rpx;
  color: var(--muted);
  font-size: 22rpx;
}

.segmented {
  display: flex;
  gap: 12rpx;
}

.seg {
  flex: 1;
  height: 72rpx;
  border-radius: 14rpx;
  border: 2rpx solid var(--line);
  line-height: 68rpx;
  text-align: center;
  font-size: 26rpx;
  box-sizing: border-box;
}

.seg.active {
  border-color: var(--ink);
  background: var(--ink);
  color: #fff;
  font-weight: 600;
}

.tiles {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
}

.tile {
  position: relative;
  height: 154rpx;
  border-radius: 14rpx;
  overflow: hidden;
  border: 4rpx solid transparent;
  background: #ece4d8;
  box-sizing: border-box;
  opacity: 0.55;
}

.tile.on {
  border-color: var(--accent);
  opacity: 1;
}

.tile image {
  width: 100%;
  height: 100%;
  display: block;
}

.tile-order {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  min-width: 36rpx;
  height: 36rpx;
  border-radius: 18rpx;
  background: var(--accent);
  color: #fff;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 36rpx;
  text-align: center;
}

.tile-label {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  color: #fff;
  font-size: 20rpx;
}

/* Undated photos ask for a date in the accent colour. */
.tile-label.undated {
  background: var(--accent);
  font-weight: 600;
}

.tile-date {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  height: 40rpx;
  white-space: nowrap;
  overflow: hidden;
}

.tile-edit {
  font-size: 18rpx;
  opacity: 0.85;
}

.tile.add {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  border: 2rpx dashed #c9bfb2;
  background: var(--card);
  color: var(--muted);
  font-size: 40rpx;
  opacity: 1;
}

.bottom-bar {
  flex: none;
  display: flex;
  gap: 16rpx;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(247, 242, 234, 0.96);
  border-top: 2rpx solid var(--line);
}

.bottom-bar .share {
  flex: 0 0 220rpx;
  width: 220rpx !important;
}

.bottom-bar .save {
  flex: 1;
}

.work-canvas {
  position: fixed;
  left: -10000px;
  top: 0;
  width: 300px;
  height: 300px;
}

.tile.add text {
  font-size: 20rpx;
}

.link {
  margin-left: 16rpx;
  color: var(--accent);
  font-size: 24rpx;
  font-weight: 600;
}

/* ---------- intro (no photos yet) ---------- */

.intro {
  flex: 1;
  min-height: 0;
}

.intro-head {
  padding: 32rpx 40rpx 8rpx;
}

.eyebrow {
  color: var(--accent);
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}

.intro-title {
  margin-top: 12rpx;
  font-family: "Songti SC", "STSong", "Noto Serif SC", serif;
  font-size: 52rpx;
  font-weight: 700;
  line-height: 1.3;
}

.em {
  color: var(--accent);
}

.intro-lead {
  margin-top: 16rpx;
  color: var(--muted);
  font-size: 26rpx;
  line-height: 1.6;
}

.gallery {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  padding: 28rpx 32rpx 8rpx;
}

.gallery-card {
  padding: 16rpx 16rpx 20rpx;
  border-radius: 24rpx;
  background: var(--card);
  box-shadow: 0 6rpx 20rpx rgba(42, 36, 32, 0.06);
}

.gallery-card:active {
  transform: scale(0.98);
}

.gallery-name {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-top: 16rpx;
  font-size: 28rpx;
  font-weight: 700;
}

.gallery-range {
  color: var(--muted);
  font-size: 20rpx;
  font-weight: 400;
}

.gallery-desc {
  margin-top: 6rpx;
  color: var(--muted);
  font-size: 22rpx;
  line-height: 1.45;
}

.steps {
  margin: 28rpx 32rpx 0;
  padding: 28rpx 28rpx 8rpx;
  border-radius: 24rpx;
  background: var(--card);
}

.steps-title {
  margin-bottom: 20rpx;
  font-size: 28rpx;
  font-weight: 700;
}

.step {
  display: flex;
  gap: 20rpx;
  padding-bottom: 24rpx;
}

.step-num {
  flex: none;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: var(--accent-soft);
  color: var(--accent);
  font-size: 24rpx;
  font-weight: 700;
  line-height: 44rpx;
  text-align: center;
}

.step-name {
  font-size: 26rpx;
  font-weight: 600;
}

.step-text {
  margin-top: 4rpx;
  color: var(--muted);
  font-size: 22rpx;
  line-height: 1.5;
}

.tip {
  margin: 20rpx 32rpx 0;
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  background: #fcefd9;
  color: #7a5212;
  font-size: 22rpx;
  line-height: 1.6;
}

.tip-title {
  display: block;
  font-weight: 700;
}

.intro-end {
  height: 32rpx;
}

/* ---------- layout picker while editing ---------- */

.layout-strip {
  padding: 20rpx 0 4rpx 24rpx;
  white-space: nowrap;
}

.layout-card {
  display: inline-block;
  width: 168rpx;
  margin-right: 16rpx;
  padding: 10rpx;
  border-radius: 20rpx;
  border: 4rpx solid transparent;
  background: var(--card);
  vertical-align: top;
  box-sizing: border-box;
}

.layout-card.active {
  border-color: var(--accent);
}

.layout-card .mini {
  height: 120rpx;
}

.layout-name {
  margin-top: 8rpx;
  font-size: 22rpx;
  font-weight: 600;
  text-align: center;
}

.swatches {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.swatch {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  width: 84rpx;
  font-size: 20rpx;
  color: var(--muted);
}

.swatch-dot {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(0, 0, 0, 0.12);
  box-sizing: border-box;
}

.swatch.active {
  color: var(--ink);
  font-weight: 600;
}

.swatch.active .swatch-dot {
  box-shadow: 0 0 0 4rpx var(--card), 0 0 0 8rpx var(--accent);
}

/* ---------- mini layout pictures ---------- */

.mini {
  position: relative;
  height: 220rpx;
  padding: 10rpx;
  border-radius: 14rpx;
  background: #f5efe5;
  overflow: hidden;
  box-sizing: border-box;
}

.mini image {
  display: block;
  width: 100%;
  height: 100%;
  border-radius: 6rpx;
}

.mini-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  grid-template-rows: 1fr 1fr;
  gap: 6rpx;
}

.mini-compare {
  display: flex;
  gap: 8rpx;
}

.mini-pair {
  position: relative;
  flex: 1;
}

.mini-pair text,
.mini-card text,
.mini-step-body text {
  position: absolute;
  left: 8rpx;
  bottom: 8rpx;
  padding: 0 10rpx;
  border-radius: 999rpx;
  background: rgba(255, 253, 249, 0.92);
  font-size: 16rpx;
  font-weight: 600;
  line-height: 28rpx;
}

.mini-hero {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.mini-hero .mini-big {
  flex: 1.6;
  min-height: 0;
}

.mini-row {
  flex: 1;
  min-height: 0;
  display: flex;
  gap: 6rpx;
}

.mini-polaroid {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  background: #efe6d8;
}

.mini-card {
  position: relative;
  width: 44%;
  padding: 6rpx 6rpx 30rpx;
  background: #fffdf8;
  box-shadow: 0 4rpx 10rpx rgba(40, 30, 20, 0.18);
  box-sizing: border-box;
}

.mini-card image {
  height: auto;
  aspect-ratio: 1;
  border-radius: 0;
}

.layout-card .mini-card image {
  height: 52rpx;
}

.mini-card text {
  left: 0;
  right: 0;
  bottom: 2rpx;
  background: none;
  font-family: "KaiTi", "STKaiti", serif;
  font-weight: 400;
  text-align: center;
}

.tilt-l {
  transform: rotate(-4deg);
}

.tilt-r {
  transform: rotate(3deg);
}

.mini-film {
  display: flex;
  justify-content: center;
  background: #efe6d8;
}

.mini-strip {
  display: flex;
  flex-direction: column;
  justify-content: space-evenly;
  width: 72%;
  padding: 0 14%;
  border-left: 6rpx dotted #efe6d8;
  border-right: 6rpx dotted #efe6d8;
  outline: 8rpx solid #1c1916;
  background: #1c1916;
  box-sizing: border-box;
}

.mini-frame {
  position: relative;
  height: 42%;
}

.mini-frame image {
  border-radius: 2rpx;
}

.mini-frame text {
  position: absolute;
  right: 6rpx;
  bottom: 2rpx;
  color: #ff9a3d;
  font-family: monospace;
  font-size: 14rpx;
  font-weight: 700;
}

.mini-timeline {
  display: flex;
  flex-direction: column;
  justify-content: space-evenly;
  padding-left: 34rpx;
}

.mini-line {
  position: absolute;
  left: 22rpx;
  top: 24rpx;
  bottom: 24rpx;
  width: 3rpx;
  background: #cdbfae;
}

.mini-step {
  position: relative;
  height: 44%;
}

.mini-dot {
  position: absolute;
  left: -20rpx;
  top: 8rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--accent);
}

.mini-step-body {
  position: relative;
  height: 100%;
}

.mini-step-body text {
  top: 6rpx;
  bottom: auto;
}
